<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.Master.cs" Inherits="HomeInventoryWarrantyTracker.SiteMaster" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%: Page.Title %> - Home Inventory & Warranty Tracker</title>
    <link href="~/Content/Site.css?v=3.5" rel="stylesheet" type="text/css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style type="text/css">
        /* Midnight Navy + Teal Theme Enforcement */
        body { background-color: #F4F7FA !important; }
        .top-header { background-color: #142D4E !important; border-bottom: 2px solid #0D9488 !important; }
        .top-header .app-title i { color: #2DD4BF !important; }
        .sidebar-toggle:hover { background: rgba(13, 148, 136, 0.35) !important; border-color: #0D9488 !important; }
        .btn-logout:hover { background-color: #0D9488 !important; border-color: #0D9488 !important; }
        .sidebar-nav { background: #142D4E !important; border-right: 1px solid #0A1C33 !important; }
        .sidebar-nav a, .sidebar-nav .nav-item, .sidebar-nav .nav-subitem { color: #CBD5E1 !important; }
        .sidebar-nav .nav-item:hover, .sidebar-nav .nav-subitem:hover { background-color: rgba(13, 148, 136, 0.22) !important; border-left-color: #0D9488 !important; color: #2DD4BF !important; }
        .sidebar-nav .nav-item-selected { background-color: rgba(13, 148, 136, 0.35) !important; border-left-color: #0D9488 !important; color: #FFFFFF !important; }
        .nav-submenu { background: #0A1C33 !important; border: 1px solid #1E3E66 !important; }
        .content-area { background: #F4F7FA !important; }
        .btn-primary, input.btn-primary[type="submit"], input.btn-primary[type="button"] { background-color: #0D9488 !important; border-color: #0D9488 !important; color: #FFFFFF !important; }
        .btn-primary:hover, input.btn-primary[type="submit"]:hover, input.btn-primary[type="button"]:hover { background-color: #0F766E !important; border-color: #0F766E !important; }
        .btn-outline, .btn-outline-primary { border-color: #0D9488 !important; color: #0D9488 !important; }
        .btn-outline:hover, .btn-outline-primary:hover { background-color: rgba(13, 148, 136, 0.15) !important; color: #0F766E !important; }
        table.grid-table th, .cal-title { background-color: #142D4E !important; color: #FFFFFF !important; }
        .cal-day a:hover, .calendar-container td:hover { background-color: #CCFBF1 !important; color: #0D9488 !important; }
        .cal-selected a, .calendar-container .selected, .grid-pager span { background-color: #0D9488 !important; color: #FFFFFF !important; }
        .cal-today a { border: 1px solid #0D9488 !important; color: #0D9488 !important; }
        .dashboard-card { border-top: 4px solid #0D9488 !important; }
        .dashboard-card.warning, .dashboard-card.warning-card { border-top-color: #F59E0B !important; }
        .form-control:focus, input[type="text"]:focus, select:focus, textarea:focus { border-color: #0D9488 !important; box-shadow: 0 0 0 3px rgba(13, 148, 136, 0.25) !important; }
        a { color: #0D9488; }
        a:hover { color: #0F766E; }
        .status-discontinued { background: #FEF3C7 !important; color: #92400E !important; border: 1px solid #FDE68A !important; }
        .breadcrumb-node a:hover, .breadcrumb-current { color: #0D9488 !important; }
        .step-number.active { background: #0D9488 !important; color: white !important; }
    </style>
    <asp:ContentPlaceHolder ID="HeadContent" runat="server" />
</head>
<body>
    <form id="form1" runat="server">
        <!-- Top Header Bar -->
        <header class="top-header">
            <div class="header-left">
                <button type="button" class="sidebar-toggle" id="sidebarToggle" onclick="toggleSidebar()" aria-label="Toggle Navigation">
                    <span class="hamburger-line"></span>
                    <span class="hamburger-line"></span>
                    <span class="hamburger-line"></span>
                </button>
                <span class="app-title"><i class="bi bi-house-door-fill"></i> Home Inventory &amp; Warranty Tracker</span>
            </div>
            <div class="header-right">
                <asp:Panel ID="pnlLoggedIn" runat="server" Visible="false">
                    <span class="welcome-text">Welcome, <asp:Label ID="lblUserName" runat="server" /></span>
                    <asp:LinkButton ID="btnLogout" runat="server" CssClass="btn-logout" OnClick="btnLogout_Click">Logout</asp:LinkButton>
                </asp:Panel>
            </div>
        </header>
        
        <div class="main-wrapper">
            <!-- Sidebar Navigation -->
            <aside id="sidebar" class="sidebar-nav">
                <asp:SiteMapDataSource ID="SiteMapDataSource1" runat="server" ShowStartingNode="false" />
                <asp:Menu ID="MainMenu" runat="server" DataSourceID="SiteMapDataSource1"
                    Orientation="Vertical" CssClass="sidebar-menu"
                    StaticMenuStyle-CssClass="nav-menu"
                    StaticMenuItemStyle-CssClass="nav-item"
                    StaticSelectedStyle-CssClass="nav-item-selected"
                    StaticHoverStyle-CssClass="nav-item-hover"
                    DynamicMenuStyle-CssClass="nav-submenu"
                    DynamicMenuItemStyle-CssClass="nav-subitem"
                    DynamicHoverStyle-CssClass="nav-item-hover">
                </asp:Menu>
            </aside>
            
            <!-- Main Content -->
            <main class="content-area">
                <!-- Breadcrumb -->
                <div class="breadcrumb-bar">
                    <asp:SiteMapPath ID="SiteMapPath1" runat="server" CssClass="breadcrumb"
                        NodeStyle-CssClass="breadcrumb-node"
                        CurrentNodeStyle-CssClass="breadcrumb-current"
                        PathSeparator=" > " />
                </div>
                
                <!-- AdRotator for maintenance tips -->
                <asp:Panel ID="pnlAdRotator" runat="server" CssClass="tip-banner" Visible="false">
                    <span class="tip-icon"><i class="bi bi-lightbulb-fill"></i></span>
                    <asp:AdRotator ID="AdRotator1" runat="server" AdvertisementFile="~/MaintenanceTips.xml" OnAdCreated="AdRotator1_AdCreated" CssClass="tip-text" />
                    <asp:Label ID="lblTipText" runat="server" CssClass="tip-text-label" Visible="false"></asp:Label>
                </asp:Panel>
                
                <asp:ContentPlaceHolder ID="MainContent" runat="server" />
            </main>
        </div>
    </form>
    
    <script type="text/javascript">
        function toggleSidebar() {
            var sidebar = document.getElementById('sidebar');
            var content = document.querySelector('.content-area');
            var toggleBtn = document.getElementById('sidebarToggle');
            var isMobile = window.innerWidth <= 768;
            
            if (isMobile) {
                sidebar.classList.toggle('sidebar-open-mobile');
                toggleBtn.classList.toggle('is-active');
            } else {
                sidebar.classList.toggle('sidebar-collapsed');
                if (content) {
                    content.classList.toggle('content-expanded');
                }
                toggleBtn.classList.toggle('is-active');
            }
        }
    </script>
</body>
</html>
